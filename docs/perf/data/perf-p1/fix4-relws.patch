+/// Free this thread's bzip2 work buffers; the thread's next decode allocates
+/// them again (a new `Decoder` allocates nothing until it decodes).
+fn release_bzip2_workspace() {
+    BZIP2_DECODER.with(|decoder| {
+        // Nothing on this thread holds the decoder between decodes, so the
+        // borrow succeeds; if it ever did not, keeping the buffers is safe.
+        if let Ok(mut decoder) = decoder.try_borrow_mut() {
+            *decoder = recast_radar_bzip2::Decoder::new();
+        }
+    });
