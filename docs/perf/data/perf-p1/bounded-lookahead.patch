+    /// Workers decode at most `ahead` blocks past the one the parser takes,
+    /// however slow the parser is: with a parser that sleeps before every
+    /// block, no block at or past `taken + ahead` is ever published, and
+    /// every block still decodes to the whole-file bytes in order.
+    #[test]
+    fn block_workers_stay_within_the_window_of_a_slow_parser() {
+        let Some(bytes) = corpus_bytes(KTLX_2024_TRIM) else {
+            return;
+        };
+        let blocks = collect_bzip_block_slices(&bytes).unwrap().unwrap();
+        assert_eq!(blocks.len(), 9);
+        let expected: Vec<Vec<u8>> = blocks.iter().map(|block| bzip2_decompress(block)).collect();
+        let workers = 2;
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(workers + 1)
+            .build()
+            .unwrap();
+        let slots = BlockSlots::new(blocks, workers);
+        assert_eq!(slots.ahead, workers + 2);
+        pool.install(|| {
+            rayon::in_place_scope(|scope| {
+                for _ in 0..workers {
+                    scope.spawn(|_| slots.run_worker());
+                }
+                for (index, expected) in expected.iter().enumerate() {
+                    std::thread::sleep(std::time::Duration::from_millis(40));
+                    for later in index + slots.ahead..slots.len() {
+                        assert!(
+                            slots.slots[later].get().is_none(),
+                            "block {later} decoded while the parser is at {index}"
+                        );
+                    }
+                    let block = slots.take_block(index).unwrap();
+                    assert!(block == *expected, "block {index}");
+                    recycle_bzip_buffer(block);
+                }
+            });
+        });
+    }
